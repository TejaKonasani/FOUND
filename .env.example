# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Next Auth (for authentication)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-production

# Feature flags
NEXT_PUBLIC_ENABLE_AI=true
NEXT_PUBLIC_ENABLE_FAMILY_INVOLVEMENT=false

# Demo Login (development only)
# Enable the "Explore with Demo Account" button on the login page.
# Requires emulator mode to be active. NEVER enable in production.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=false
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
NEXT_PUBLIC_DEMO_EMAIL=demo@found.in
NEXT_PUBLIC_DEMO_PASSWORD=DemoPassword123!
